<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    
    <!-- Audio Input (Microphone access for recording) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    
    <!-- User-selected file access (read/write) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Allow loading Audio Units (plugins) out of process -->
    <!-- Required for AUv3 plugin hosting -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <!-- Audio HAL daemon -->
        <string>com.apple.audio.audiohald</string>
        <!-- Core Audio server -->
        <string>com.apple.audio.coreaudiod</string>
    </array>
    
    <!-- Allow unsigned Audio Units -->
    <!-- Required for some third-party AU plugins -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- Allow loading arbitrary libraries -->
    <!-- Required for VST3 plugin hosting -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- Allow DYLD environment variables -->
    <!-- May be needed for some plugin frameworks -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
